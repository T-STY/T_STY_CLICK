rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────
// UNIFIED RULESET — shared by BOTH repos on Firebase project arthemis-f2966:
//   • client : /Users/cotton/StudioProjects/click-main      (T_STY: Beyond)
//   • admin  : /Users/cotton/StudioProjects/t_sty_delivery   (Admin Delivery)
//
// This exact file lives in both repos. Whichever repo runs
// `firebase deploy --only firestore:rules` overwrites the project's rules, so
// the two copies MUST stay byte-for-byte identical. When you change one, copy
// it to the other.
//
// Security model:
// 1. Admins = full access (catch-all at the bottom). Two true admins.
// 2. Stock editors = trusted employees who may edit a product's `stock` only
//    (diff-checked) plus append inventory/correction logs — nothing else.
// 3. Workers write employee data only via /users/{uid}/workerActions, applied
//    by the processWorkerAction Cloud Function with admin credentials.
// 4. Wallets (`rewards`) are Cloud-Function-only — clients get NO direct
//    access so PINs/PII can't be read and balances can't be tampered with.
// 5. Storefront content (products, recipes, promotions, home_sections, ads)
//    is publicly readable so the customer app renders for guests too.
//    Coupons are NOT public — admin-only, claimed via the claimCoupon CF.
// Keep the [AdminGuard] Dart lists in the admin app in lock-step with the
// isAdmin()/isStockEditor() UID lists below.
// ─────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── HELPERS ───────────────────────────────────────────────
    function isAdmin() {
      return request.auth != null && request.auth.uid in [
        'HnqE2Asz6HPvmM10OAIAsu1RaL62',
        'dZ8iFN6Gg4N3vykY7GUya2hyYiL2',
      ];
    }

    function isStockEditor() {
      return request.auth != null && request.auth.uid in [
        'MzmOCRtAwgU6NgkxzCfRuEnfRug1',
        'sQRF7ztfOOWJZnmQsBftBOmSgVH2',
        'CU6jbAP7iPh9PeaL3KEV1CGYGxJ2',
      ];
    }

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // The worker that owns employeeDoc == the caller.
    function isOwnedBy(employeeId) {
      return isAuth()
        && exists(/databases/$(database)/documents/employee/$(employeeId))
        && get(/databases/$(database)/documents/employee/$(employeeId)).data.uuid == request.auth.uid;
    }

    // Stock-editor update gate: the diff must only touch `stock`. Any attempt
    // to co-edit price / cost / name alongside the stock number is rejected.
    function isStockOnlyUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock'])
          && request.resource.data.stock is number
          && request.resource.data.stock >= 0;
    }

    // ─── 1. MASTER COUPONS ────────────────────────────────────
    // Admin-only — clients never touch the master pool directly. Claiming a
    // coupon (validating the code, copying percentage/max_discount onto the
    // user, decrementing remaining_uses) happens exclusively in the claimCoupon
    // Cloud Function (admin SDK), so a client can never read the master pool,
    // mint coupons, or tamper with usage counts.
    match /coupons/{couponId} {
      allow read, create, update, delete: if isAdmin();
    }

    // ─── 2. ORDERS ────────────────────────────────────────────
    // Orders are CREATED server-side by the placeOrder Cloud Function (admin
    // SDK), which recomputes prices/discounts/saldo — clients never create or
    // delete. A customer may READ their own order and may only UPDATE it to
    // cancel: the order must still be 'En Revision' OR 'Preparando' (nothing
    // has shipped or deducted stock at either stage), the diff may touch
    // nothing but `state` (→ 'Cancelado') and `cancellationTimestamp`, so a
    // client can't flip an order to 'Entregado' or rewrite items/totals.
    // Saldo + coupon are reinstated server-side by reinstateOnCancel.
    // Admin via catch-all.
    match /orders/{orderId} {
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      allow update: if isAuth()
        && resource.data.userId == request.auth.uid
        && (resource.data.state == 'En Revision'
            || resource.data.state == 'Preparando')
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['state', 'cancellationTimestamp'])
        && request.resource.data.state == 'Cancelado';
    }

    // ─── 3. PRODUCTS, RECIPES & PROMOTIONS ────────────────────
    match /products/{docId} {
      allow read:   if true;
      allow create, delete: if isAdmin();
      // Admin: any field. StockEditor: only `stock` (diff-checked).
      allow update: if isAdmin() || (isStockEditor() && isStockOnlyUpdate());
    }

    // Public read: recipes are storefront content shown to guests too.
    match /recipes/{docId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // Public read: the customer home shows a promo carousel + cart combos to
    // guests too. Promotions are marketing data (no PII).
    match /promotions/{docId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ─── 4. REWARDS (server-managed) ──────────────────────────
    // All access goes through Cloud Functions (admin SDK), which bypass these
    // rules. Clients get NO direct access, so wallet PINs/PII cannot be read
    // or brute-forced and balances cannot be tampered with. Linking/creation/
    // updates/redemption all run server-side (createRewardsWallet,
    // linkRewardsWallet, updateRewardsCard, getRewardsBalance, placeOrder).
    // The PDV recharger signs in as an admin UID, so it still has access.
    match /rewards/{docId} {
      allow read, write: if isAdmin();
    }

    // Rate-limit bookkeeping for wallet linking — Functions/admin only.
    match /rewardsLinkAttempts/{docId} {
      allow read, write: if isAdmin();
    }

    // ─── 5. CATEGORIES ────────────────────────────────────────
    match /private/categories/{docId} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    // Both spellings/locations kept so neither repo loses a rule it had.
    match /employeecategories/{docId} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    match /employee/categories/{docId} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    // ─── 6. USER DATA ─────────────────────────────────────────
    // Each signed-in user owns their own document + subcollections (cart,
    // FCM tokens, etc.). `workerActions` is the staging inbox the worker
    // writes to; the CF reads it, mutates the canonical employee tree, then
    // marks the doc processed.
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /workerActions/{actionId} {
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasAll(['type', 'payload', 'status', 'createdAt'])
          && request.resource.data.status == 'pending'
          && request.resource.data.type in [
               'clock_in',
               'task_complete',
               'task_evidence',
               'vacation_request',
               'cancel_vacation_request'
             ];
        allow read: if isOwner(userId) || isAdmin();
        allow update, delete: if isAdmin();
      }

      // Coupons are granted ONLY by the claimCoupon Cloud Function (admin SDK).
      // Clients may read them (to list/apply) and delete them (account cleanup),
      // but never create or modify — otherwise a user could fabricate a coupon
      // with an arbitrary discount that placeOrder would honor.
      match /coupons/{couponId} {
        allow read, delete: if isOwner(userId);
      }

      // Order archive — CF-managed only. The `archiveDeletedOrderHistory`
      // trigger mirrors every `orderHistory` delete here so support can
      // look up old orders even after a client cleanup. Owners can READ
      // their own archive (it's their data), but nobody on the client
      // side can ever write or delete — otherwise a tampered app could
      // erase its own paper trail right after the mirror happens.
      match /order_archive/{archiveId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if false;
      }

      // Everything else under the user's tree stays fully owner-managed. The
      // `col` guards keep client writes OUT of coupons, workerActions,
      // order_archive AND rewardsCard. Rules are OR-ed, so a broad
      // write here would otherwise re-open them:
      //   - coupons:       CF-granted only.
      //   - workerActions: own constrained create rule above (type/
      //                    status validated).
      //   - order_archive: immutable support-recovery log.
      //   - rewardsCard:   linked-wallet card info — clients used to
      //                    write `saldo` directly here (the arcade
      //                    game flow). That client-side saldo write
      //                    is now obsolete (every saldo move routes
      //                    through the `updateRewardsSaldo` callable
      //                    which mirrors the new value into this doc
      //                    server-side via admin SDK), and any
      //                    remaining client write is a tamper vector.
      //                    Block it at the rule level too.
      match /{col}/{docId=**} {
        allow read:  if isOwner(userId);
        allow write: if isOwner(userId)
          && col != 'coupons'
          && col != 'workerActions'
          && col != 'order_archive'
          && col != 'rewardsCard';
      }
    }

    // ─── 7. STORE CONFIG / SETTINGS ───────────────────────────
    match /store/config {
      allow read:  if isAdmin() || isStockEditor();
      allow write: if isAdmin();
    }

    match /store/permissions {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    match /store/specifics {
      // Bulk screens + product editor read brand/distributor option lists.
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    // Per-screen barcode access tokens used by the kiosk. Any signed-in user
    // can read (so managers can show the code to a cashier), only admins
    // regenerate or disable.
    match /store/access_codes {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    // Generic settings (store pricing, delivery fees by colonia, etc.).
    match /settings/{docId} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    // ─── 7b. STOCK-CORRECTION AUDIT LOG ───────────────────────
    // Stock editors + admins append entries. No edits/deletes once written.
    match /stock_corrections/{docId} {
      allow read:   if isAdmin() || isStockEditor();
      allow create: if isAdmin() || (isStockEditor()
        && request.resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // ─── 7c. INVENTORY ENTRY LOGS ─────────────────────────────
    match /inventory_logs/{docId} {
      allow read:   if isAdmin() || isStockEditor();
      allow create: if isAdmin() || isStockEditor();
      allow update, delete: if isAdmin();
    }

    // ─── 7d. STOCKOUT LOGS ────────────────────────────────────
    // Append-only audit trail of every product/variant that crossed
    // > 0 → ≤ 0 stock, written by the `logProductStockouts` CF.
    // Clients (admin + stock editor) read only; the CF writes via admin
    // SDK which bypasses rules. The catch-all override at the bottom of
    // this file carves stockout_logs out of admin-write so even a
    // compromised admin session can't tamper with the trail.
    match /stockout_logs/{docId} {
      allow read:  if isAdmin() || isStockEditor();
      allow write: if false;
    }

    // ─── 7e. PUSH AUDIT LOG ───────────────────────────────────
    // Every FCM send attempt (broadcast, order_status, order_new) is
    // mirrored here by the push-sending CFs so the admin can answer
    // "did this user actually get the coupon I sent last week?" with a
    // Firestore query. Admin-only read; ALL client writes denied
    // (`if false`) so the audit trail can't be tampered with by anyone
    // outside the admin SDK — including spoofed-admin requests via
    // user-token writes.
    match /push_log/{docId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // ─── 8. EMPLOYEE TREE ─────────────────────────────────────
    // Canonical source of truth for employee data. Workers READ only — every
    // write is CF-mediated via /users/{uid}/workerActions.
    match /employee/{employeeId} {
      allow read: if isAdmin()
        || (isAuth() && resource.data.uuid == request.auth.uid);
      // Write: admin only (catch-all).

      match /schedules/{monthId} {
        allow read: if isAdmin() || isOwnedBy(employeeId);
      }

      match /tasks/{taskId} {
        allow read: if isAdmin() || isOwnedBy(employeeId);
      }

      match /recurringTasks/{ruleId} {
        allow read: if isAdmin() || isOwnedBy(employeeId);
      }

      match /recurringSkips/{skipId} {
        allow read: if isAdmin() || isOwnedBy(employeeId);
      }

      match /vacationRequests/{requestId} {
        allow read: if isAdmin() || isOwnedBy(employeeId);
      }

      match /scheduleTemplates/{templateId} {
        allow read, write: if isAdmin();
      }
    }

    // Admin-only listing. Workers never list the whole collection; their
    // self-lookup is a `where('uuid','==', request.auth.uid)` query, which is
    // authorized by the per-document read rule above (resource.data.uuid ==
    // request.auth.uid) — so tightening list to admins doesn't break it.
    match /employee {
      allow list: if isAdmin();
    }

    // ─── 8b. STOREFRONT CONTENT (customer-facing) ─────────────
    // Customer app (incl. guest browsing) reads these to render the home
    // screen; writes are admin-only from the dashboard.
    match /home_sections/{docId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    match /ads/{docId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // Coupon broadcasts: admin composes; the sendCouponBroadcast CF (admin
    // credentials) fans out the FCM push and writes status back. Admin-only.
    match /coupon_broadcasts/{docId} {
      allow read, write: if isAdmin();
    }

    // ─── 9. ADMIN GLOBAL OVERRIDE ─────────────────────────────
    // Must be last — grants admins full access to any path not matched above.
    //
    // ⚠ DO NOT try to carve out audit collections via path inspection
    // (e.g. `document[0] != 'push_log'`, or split-rule patterns with
    // wildcard `{col}` segments). Path indexing on a recursive
    // wildcard does NOT resolve during LIST evaluation and silently
    // denies admin queries on every top-level collection (broke PDV
    // login on `employee`/`cortes`). Wildcard `{col}` segments do NOT
    // enable COLLECTION GROUP queries — Firestore requires a concrete
    // collection name there, so a `{path=**}/{col}/{docId}` carve-out
    // silently denies `collectionGroup('tickets')` (broke PDV ticket
    // sparkline and credit-sale paths). The single `{document=**}`
    // recursive wildcard is the only form that authorizes everything
    // admins legitimately need — including CG queries.
    //
    // ⚠ Trade-off: rules are UNIONED, so this catch-all OR-overrides
    // the dedicated `allow write: if false;` on `push_log` and
    // `stockout_logs`. Admins technically CAN write to those from a
    // client. Tamper resistance in practice comes from:
    //   1. Neither admin app exposes a UI that writes to audit logs.
    //   2. Cloud Functions (admin SDK) are the canonical writer.
    //   3. push_log carries `expireAt` for automatic 180d TTL purge.
    // If true tamper-proofing is required later, move audit log
    // collections under a parent-document path that the catch-all
    // cannot match (e.g. `system/_audit/push_log/{id}`) and grant
    // admin write nowhere in this file.
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
