rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── HELPERS ───────────────────────────────────────────────
    function isAdmin() {
      return request.auth != null && request.auth.uid in [
        'HnqE2Asz6HPvmM10OAIAsu1RaL62',
        'MzmOCRtAwgU6NgkxzCfRuEnfRug1',
        'dZ8iFN6Gg4N3vykY7GUya2hyYiL2'
      ];
    }

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Only the 'saldo' field changed, decremented by a positive amount, stays >= 0
    function isValidSaldoDecrement() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['saldo'])
          && request.resource.data.saldo is number
          && request.resource.data.saldo < resource.data.saldo
          && request.resource.data.saldo >= 0;
    }

    // Only 'remaining_uses' changed, decremented by exactly 1, was > 0
    function isValidCouponClaim() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['remaining_uses'])
          && request.resource.data.remaining_uses == resource.data.remaining_uses - 1
          && resource.data.remaining_uses > 0;
    }

    // ─── 1. MASTER COUPONS ────────────────────────────────────
    match /coupons/{couponId} {
      allow read:            if true;
      allow update:          if isAdmin() || isValidCouponClaim();
      allow create, delete:  if isAdmin();
    }

    // ─── 2. ORDERS ────────────────────────────────────────────
    match /orders/{orderId} {
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // ─── 3. PRODUCTS & RECIPES ────────────────────────────────
    match /products/{docId} {
      allow read:   if true;
      allow write:  if isAdmin();
    }

    match /recipes/{docId} {
      allow read:   if isAuth();
      allow write:  if isAdmin();
    }

    // ─── 4. REWARDS ───────────────────────────────────────────
    // Doc ID = userId, so ownership is docId == auth.uid
    match /rewards/{docId} {
      allow read:            if isOwner(docId);
      allow create, delete:  if isAdmin();
      allow update:          if isAdmin() || (isOwner(docId) && isValidSaldoDecrement());
    }

    // ─── 5. CATEGORIES ───────────────────────────────────────
    match /private/categories/{docId} {
      allow read:   if isAuth();
      allow write:  if isAdmin();
    }

    match /employee/categories/{docId} {
      allow read:   if isAuth();
      allow write:  if isAdmin();
    }

    // ─── 6. USER DATA ────────────────────────────────────────
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /{sub=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // ─── 7. SETTINGS ─────────────────────────────────────────
    match /settings/{docId} {
      allow read:   if isAuth();
      allow write:  if isAdmin();
    }

    // ─── 8. ADMIN GLOBAL OVERRIDE ────────────────────────────
    // Must be last — grants admins full access to any path
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
